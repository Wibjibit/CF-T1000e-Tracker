{
  "name": "cf-t1000e-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare-hosted map + timeline for a SenseCAP T1000-E LoRaWAN tracker.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev --config dist/server/wrangler.json",
    "deploy": "astro build && wrangler deploy --config dist/server/wrangler.json",
    "check": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "astro": "astro",
    "totp:init": "node scripts/totp-init.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.5.1",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "astro": "^6.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.75.0"
  }
}
