# Copy this file to .dev.vars and fill in real values for local development.
# In production, set these via:
#   wrangler secret put TTN_BASIC_AUTH_USER
#   wrangler secret put TTN_BASIC_AUTH_PASS
#   wrangler secret put TOTP_SECRET
#   wrangler secret put COOKIE_SECRET
#   wrangler secret put EXPECTED_DEV_EUI
# Or paste them into the Cloudflare dashboard under Workers -> Settings -> Variables.

# TTN webhook Basic auth. Set the same username + password on the TTN
# Console webhook ("Use basic access authentication") so its POST to
# /api/ingest carries an Authorization: Basic ... header we accept.
TTN_BASIC_AUTH_USER=ttn
TTN_BASIC_AUTH_PASS=replace-with-a-long-random-string

# TOTP shared secret (base32). The `npm run totp:init` helper generates
# one, prints a QR for Google Authenticator / Authy / 1Password, and can
# optionally write it straight into this file.
TOTP_SECRET=

# 32-byte random hex string used to sign session cookies. `totp:init`
# generates this too.
COOKIE_SECRET=

# Device identity. Ingest will reject uplinks from any other DevEUI.
# Find yours in the TTN Console under your registered end device.
# Format: 16 hex chars, no separators. The ingest handler normalises to
# uppercase before comparing, so either case works here.
EXPECTED_DEV_EUI=REPLACE_WITH_YOUR_16_HEX_DEVEUI
