---
// Served via the Worker (not prerendered) so the auth middleware can gate it.
// The HTML is content-free; all data is fetched client-side from /api/points
// (which now reads the unified `reports` timeline) and /api/devices.
import Layout from '../layouts/Layout.astro';
export const prerender = false;
---
<Layout title="T1000-E Tracker — map">
  <link
    slot="head"
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin="anonymous"
  />

  <div class="page-bar">
    <h1>Map</h1>
    <span id="status" class="status">loading&hellip;</span>
    <label class="auto-refresh" title="Re-fetch every 5 minutes">
      <input type="checkbox" id="auto-refresh" />
      Auto-refresh
    </label>
    <div class="ranges">
      <select id="device-select" aria-label="Device">
        <option value="">All devices</option>
      </select>
    </div>
    <div class="ranges">
      <select id="range-select" aria-label="Time range">
        <option value="1h">Last hour</option>
        <option value="6h">Last 6 hours</option>
        <option value="24h" selected>Last 24 hours</option>
        <option value="7d">Last 7 days</option>
        <option value="30d">Last 30 days</option>
        <option value="all">All time</option>
      </select>
    </div>
  </div>

  <div id="map"></div>

  <script
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
    crossorigin="anonymous"
    is:inline
  ></script>
  <script>
    // @ts-nocheck
    // Bundled by Astro. window.L (Leaflet) comes from the classic CDN
    // <script> above; classic scripts run before module scripts so it's
    // there by the time we execute. @ts-nocheck because Leaflet's runtime
    // globals aren't typed in this project — the data flow into the page
    // is exercised by the existing CI build + manual smoke tests.
    import { wireDashboard, fetchDevices, populateDeviceSelect, deviceFromQuery } from '../scripts/dashboard';

    // Pin colour by source_type (docs/architecture.md "UI"). Only 'lora' has
    // data today; the rest are wired so adding a source later just lights up
    // its colour + legend row with zero map changes.
    const SOURCE_COLORS = {
      lora: '#3aaa3a',                 // green
      findhub: '#1d68d0',              // blue
      findmy: '#e8730c',               // orange
      google_maps_sharing: '#8a44d3',  // purple
    };
    const SOURCE_LABELS = {
      lora: 'LoRaWAN',
      findhub: 'Find Hub',
      findmy: 'Apple Find My',
      google_maps_sharing: 'Maps sharing',
    };
    const colorFor = (s) => SOURCE_COLORS[s] || '#888';

    const L = window.L;
    const map = L.map('map', { zoomControl: true }).setView([52.5, -1.5], 6);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    }).addTo(map);

    // Legend control (bottom-right). Hidden until a load reports which
    // source_types are actually present in the current view.
    const legend = L.control({ position: 'bottomright' });
    legend.onAdd = () => L.DomUtil.create('div', 'pin-legend');
    legend.addTo(map);
    function renderLegend(sourceTypes) {
      const el = document.querySelector('.pin-legend');
      if (!el) return;
      if (!sourceTypes.length) { el.innerHTML = ''; el.style.display = 'none'; return; }
      el.style.display = 'block';
      el.innerHTML = sourceTypes
        .map((s) => `<div class="row"><span class="dot" style="background:${colorFor(s)}"></span>${SOURCE_LABELS[s] || s}</div>`)
        .join('');
    }

    const statusEl = document.getElementById('status');
    let polyline = null;
    let currentMarker = null;

    const setStatus = (msg) => { if (statusEl) statusEl.textContent = msg; };

    function fmtAgo(ts) {
      const diff = Date.now() - ts;
      if (diff < 60_000) return Math.floor(diff / 1000) + 's ago';
      if (diff < 3_600_000) return Math.floor(diff / 60_000) + 'm ago';
      if (diff < 86_400_000) return Math.floor(diff / 3_600_000) + 'h ago';
      return Math.floor(diff / 86_400_000) + 'd ago';
    }

    async function load(range, deviceId) {
        setStatus('loading ' + range + '…');
        let qs = '/api/points?range=' + encodeURIComponent(range) + '&with_fix=1';
        if (deviceId) qs += '&device_id=' + encodeURIComponent(deviceId);
        const res = await fetch(qs, { credentials: 'same-origin' });
        if (!res.ok) {
          setStatus('error: HTTP ' + res.status);
          return;
        }
        const body = await res.json();
        const points = body.points || [];

        if (polyline) { map.removeLayer(polyline); polyline = null; }
        if (currentMarker) { map.removeLayer(currentMarker); currentMarker = null; }

        if (points.length === 0) {
          renderLegend([]);
          setStatus('no fixes in ' + range);
          return;
        }

        // points is already chronological (ASC). Draw a track polyline coloured
        // by the source if the whole track is one source, else a neutral grey.
        const present = Array.from(new Set(points.map((p) => p.source_type)));
        const coords = points.map((p) => [p.lat, p.lon]);
        const trackColor = present.length === 1 ? colorFor(present[0]) : '#777';
        polyline = L.polyline(coords, { color: trackColor, weight: 3, opacity: 0.8 }).addTo(map);

        // Current position = last point, coloured by its source.
        const last = points[points.length - 1];
        currentMarker = L.circleMarker([last.lat, last.lon], {
          radius: 7, color: '#fff', weight: 2,
          fillColor: colorFor(last.source_type), fillOpacity: 1,
        }).addTo(map);
        currentMarker.bindPopup(
          '<strong>Current</strong> (' + (SOURCE_LABELS[last.source_type] || last.source_type) + ')<br>' +
            fmtAgo(last.ts) + '<br>' +
            'Battery ' + (last.battery_pct ?? '?') + '% (' + (last.battery_mv ?? '?') + ' mV)<br>' +
            'Temp ' + (last.temp_c ?? '?') + ' &deg;C, Lux ' + (last.lux_pct ?? '?') + '%',
        );

      renderLegend(present);
      map.fitBounds(polyline.getBounds(), { padding: [40, 40] });
      setStatus(points.length + ' point' + (points.length === 1 ? '' : 's') + ' (' + range + ')' + (body.truncated ? ' &mdash; truncated' : ''));
    }

    // Populate the device selector from /api/devices, restoring the
    // ?device= selection, then wire the dashboard (which fires the first load).
    const deviceSelect = document.getElementById('device-select');
    (async () => {
      const devices = await fetchDevices();
      if (deviceSelect) populateDeviceSelect(deviceSelect, devices, deviceFromQuery());
      wireDashboard({
        selectId: 'range-select',
        checkboxId: 'auto-refresh',
        deviceSelectId: 'device-select',
        load,
      });
    })();
  </script>
</Layout>

<style>
  #map { flex: 1 1 auto; min-height: 0; }

  /* Source-colour legend overlay (Leaflet control). */
  :global(.pin-legend) {
    background: rgba(255, 255, 255, 0.9);
    color: #222;
    padding: 0.4rem 0.6rem;
    border-radius: 0.4rem;
    box-shadow: 0 1px 5px rgba(0, 0, 0, 0.3);
    font-size: 0.8rem;
    line-height: 1.5;
  }
  :global(.pin-legend .row) { display: flex; align-items: center; gap: 0.4rem; }
  :global(.pin-legend .dot) {
    width: 0.7rem; height: 0.7rem; border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.3); flex: 0 0 auto;
  }
</style>
