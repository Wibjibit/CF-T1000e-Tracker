  /* ── table tab ── */
  .table-wrap { max-width: 70rem; margin: 0 auto; padding: 1rem; width: 100%; }
  .filters { display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem; }
  .filters fieldset {
    border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    border-radius: 0.45rem; padding: 0.5rem 0.8rem 0.7rem;
  }
  .filters legend { font-size: 0.72rem; opacity: 0.6; text-transform: uppercase; letter-spacing: 0.04em; }
  .src-checks { display: flex; flex-wrap: wrap; gap: 0.4rem 0.9rem; }
  /* JS-injected (buildSourceFilter), so :global — scoped rules wouldn't match. */
  :global(.src-checks .src-check) { display: inline-flex; align-items: center; gap: 0.35em; font-size: 0.85rem; }
  :global(.src-checks .src-check .dot) { width: 0.7em; height: 0.7em; border-radius: 50%; display: inline-block; }
  .range-filter label { font-size: 0.82rem; display: inline-flex; flex-direction: column; gap: 0.15rem; margin-right: 0.6rem; }
  .range-filter input { font: inherit; padding: 0.25em 0.4em; border-radius: 0.3em; background: transparent; color: inherit; border: 1px solid color-mix(in srgb, currentColor 28%, transparent); }
  button.ghost { font: inherit; font-size: 0.8rem; padding: 0.3em 0.7em; cursor: pointer; background: transparent; color: inherit; border: 1px solid color-mix(in srgb, currentColor 28%, transparent); border-radius: 0.3em; align-self: end; }

  /* Static (template) bits stay scoped. */
  .table-card {
    border: 1px solid color-mix(in srgb, currentColor 16%, transparent);
    border-radius: 0.55rem; overflow: hidden;
  }
  #data-table { width: 100%; border-collapse: collapse; font-size: 0.86rem; }
  #data-table thead th {
    background: color-mix(in srgb, currentColor 7%, transparent);
    font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
    opacity: 0.75; text-align: left; padding: 0.55em 0.8em;
    border-bottom: 1px solid color-mix(in srgb, currentColor 20%, transparent);
  }
  #data-table thead th.exp { width: 2rem; }
  .empty { padding: 2rem; text-align: center; opacity: 0.55; }

  /* Everything below is injected at runtime (loadTable / buildDetail builds the
     rows + the expanded pane via innerHTML), so it never gets Astro's scoped
     attribute — it MUST be :global or the CSS silently doesn't apply (that's
     why the pane rendered as a raw list). Namespaced under #data-table so the
     generic class names (.muted, dl.kv, .btn) can't leak to other pages. */
  :global(#data-table td) { padding: 0.5em 0.8em; border-bottom: 1px solid color-mix(in srgb, currentColor 10%, transparent); vertical-align: middle; }
  :global(#data-table tbody tr:last-child td) { border-bottom: 0; }
  :global(#data-table td.exp) { width: 2rem; text-align: center; padding-left: 0.5em; padding-right: 0.5em; }
  :global(#data-table .data-row) { cursor: pointer; }
  :global(#data-table .data-row:hover) { background: color-mix(in srgb, currentColor 6%, transparent); }
  :global(#data-table .data-row.open) { background: color-mix(in srgb, var(--accent) 10%, transparent); }
  :global(#data-table .data-row.open td) { border-bottom-color: transparent; }
  :global(#data-table .data-row .chev) { display: inline-block; opacity: 0.55; }
  :global(#data-table .data-row.open .chev) { opacity: 0.9; }
  :global(#data-table .data-row .ago) { font-size: 0.72rem; opacity: 0.55; }
  :global(#data-table .data-row .pos) { font-variant-numeric: tabular-nums; }
  :global(#data-table .src-badge) { display: inline-block; padding: 0.1em 0.55em; border-radius: 0.3em; font-size: 0.76em; font-weight: 600; color: #fff; }
  :global(#data-table .muted) { opacity: 0.5; }
  :global(#data-table .muted.small) { font-size: 0.8rem; opacity: 0.6; }
  :global(#data-table .home-tag) { font-size: 0.78em; opacity: 0.7; white-space: nowrap; }

  /* Expanded "informative pane" — grouped, formatted sections + a mini-map. */
  :global(#data-table .detail-row > td) { background: color-mix(in srgb, var(--accent) 5%, transparent); padding: 0; }
  :global(#data-table .detail) { padding: 0.85rem 1rem 1.05rem; }
  :global(#data-table .pane-head) { display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 0.85rem; }
  :global(#data-table .pane-head .pane-device) { font-weight: 600; }
  :global(#data-table .pane-head .pane-time) { font-size: 0.8rem; opacity: 0.6; margin-left: auto; }
  :global(#data-table .pane-body) { display: flex; gap: 1.1rem; align-items: flex-start; }
  :global(#data-table .pane-info) { flex: 1 1 auto; min-width: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 0.7rem; align-content: start; }
  :global(#data-table .pane-sec) {
    border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    border-radius: 0.45rem; padding: 0.55rem 0.75rem 0.65rem;
    background: color-mix(in srgb, Canvas 55%, transparent);
  }
  :global(#data-table .pane-sec h4) { margin: 0 0 0.45rem; font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.55; }
  :global(#data-table dl.kv) { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 0.2rem 0.9rem; font-size: 0.84rem; }
  :global(#data-table dl.kv dt) { opacity: 0.6; white-space: nowrap; }
  :global(#data-table dl.kv dd) { margin: 0; text-align: right; font-variant-numeric: tabular-nums; word-break: break-word; }
  :global(#data-table .sec-actions) { margin-top: 0.6rem; }
  :global(#data-table .detail .btn) {
    display: inline-block; font-size: 0.8rem; text-decoration: none; color: inherit;
    padding: 0.32em 0.75em; border-radius: 0.3em; border: 1px solid color-mix(in srgb, currentColor 28%, transparent);
  }
  :global(#data-table .detail .btn:hover) { background: color-mix(in srgb, currentColor 10%, transparent); }
  :global(#data-table .mini-map) { flex: 0 0 320px; height: 250px; border-radius: 0.45rem; overflow: hidden; border: 1px solid color-mix(in srgb, currentColor 14%, transparent); }
  @media (max-width: 819px) {
    :global(#data-table .pane-body) { flex-direction: column; }
    :global(#data-table .mini-map) { flex-basis: auto; width: 100%; }
  }
  :global(#data-table .pane-extras) { margin-top: 0.85rem; display: flex; flex-direction: column; gap: 0.45rem; }
  :global(#data-table .extra) { font-size: 0.82rem; }
  :global(#data-table .extra summary) { cursor: pointer; opacity: 0.75; padding: 0.2em 0; }
  :global(#data-table pre.raw) { background: color-mix(in srgb, currentColor 8%, transparent); padding: 0.6rem; border-radius: 0.35rem; overflow: auto; max-height: 22rem; font-size: 0.78rem; margin: 0.3rem 0 0; }
  :global(#data-table .gw-table) { border-collapse: collapse; font-size: 0.8rem; margin-top: 0.4rem; }
  :global(#data-table .gw-table th), :global(#data-table .gw-table td) { text-align: left; padding: 0.2em 0.9em 0.2em 0; border-bottom: 0; }
</style>
