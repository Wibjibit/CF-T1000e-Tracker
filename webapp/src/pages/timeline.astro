    display: flex; gap: 0.15rem; padding: 0 1rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 16%, transparent);
    flex: 0 0 auto;
  }
  .tabbar .tab {
    font: inherit; font-size: 0.9rem; cursor: pointer; color: inherit;
    background: transparent; border: 0; padding: 0.6em 1.1em; opacity: 0.6;
    border-bottom: 2px solid transparent; margin-bottom: -1px;
  }
  .tabbar .tab:hover:not(.active) { opacity: 0.85; }
  .tabbar .tab.active { opacity: 1; font-weight: 600; color: var(--accent); border-bottom-color: var(--accent); }

  .charts {
    padding: 1rem; display: flex; flex-direction: column; gap: 1.25rem;
    max-width: 64rem; margin: 0 auto; width: 100%;
  }
