---
import { env } from 'cloudflare:workers';
import { formatAgo, formatLatLon } from '../lib/format';

interface LatestRow {
  ts: number;
  lat: number | null;
  lon: number | null;
  alt: number | null;
  fix: number;
  sats_tracked: number | null;
  sats_in_view: number | null;
  hdop: number | null;
  speed: number | null;
  battery_pct: number | null;
  battery_mv: number | null;
  temp_c: number | null;
  lux_pct: number | null;
  motion: 0 | 1;
  rssi: number | null;
  snr: number | null;
  sf: number | null;
  gateway_id: string | null;
  dev_eui: string;
  f_cnt: number;
}

const LATEST_COLUMNS = `
  received_at AS ts,
  latitude AS lat, longitude AS lon, altitude_m AS alt,
  fix_quality AS fix, sats_tracked, sats_in_view, hdop, speed_kmh AS speed,
  battery_pct, battery_mv, temp_c, lux_pct, motion,
  rssi, snr, spreading_factor AS sf, gateway_id,
  dev_eui, f_cnt
`;

// SSR: pick the most recent uplink with a valid fix, plus the absolute latest
// (which may be a no-fix frame — useful to show "device is alive but searching").
const latestWithFix = await env.DB.prepare(
  `SELECT ${LATEST_COLUMNS}
     FROM uplinks WHERE fix_quality > 0 AND latitude IS NOT NULL
     ORDER BY received_at DESC LIMIT 1`,
).first<LatestRow>();

const latestAny = await env.DB.prepare(
  `SELECT ${LATEST_COLUMNS}
     FROM uplinks ORDER BY received_at DESC LIMIT 1`,
).first<LatestRow>();

function fixLabel(fix: number | null | undefined): string {
  if (fix === 1) return 'GPS';
  if (fix === 2) return 'DGPS';
  return 'invalid';
}

function shortGateway(id: string | null): string {
  if (!id) return '—';
  // eui-3234333640004d00 -> 4d00
  const m = id.match(/[0-9a-fA-F]{4}$/);
  return m ? '…' + m[0] : id;
}
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>T1000-E Tracker</title>
    {latestWithFix !== null && (
      <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
        crossorigin="anonymous"
      />
    )}
    <style>
      :root { color-scheme: light dark; }
      body { font-family: system-ui, sans-serif; max-width: 36rem; margin: 3rem auto; padding: 0 1rem; line-height: 1.5; }
      h1 { margin-bottom: 0.25rem; }
      .sub { color: color-mix(in srgb, currentColor 55%, transparent); margin-top: 0; }
      .card { border: 1px solid color-mix(in srgb, currentColor 20%, transparent); border-radius: 0.5rem; padding: 1rem 1.25rem; margin: 1rem 0; }
      .row { display: flex; justify-content: space-between; gap: 1rem; }
      .row + .row { margin-top: 0.35rem; }
      .label { color: color-mix(in srgb, currentColor 55%, transparent); }
      .value { font-variant-numeric: tabular-nums; }
      .group { margin-top: 0.85rem; padding-top: 0.85rem; border-top: 1px solid color-mix(in srgb, currentColor 12%, transparent); }
      .group-title { font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: color-mix(in srgb, currentColor 50%, transparent); margin-bottom: 0.45rem; }
      .pill { display: inline-block; padding: 0.05em 0.5em; border-radius: 999px; font-size: 0.78em; background: color-mix(in srgb, currentColor 12%, transparent); }
      .pill.motion { background: color-mix(in srgb, orange 30%, transparent); }
      a.button { display: inline-block; padding: 0.5em 0.9em; border-radius: 0.4em; background: color-mix(in srgb, currentColor 12%, transparent); color: inherit; text-decoration: none; }
      a.button:hover { background: color-mix(in srgb, currentColor 22%, transparent); }
      code { background: color-mix(in srgb, currentColor 10%, transparent); padding: 0.1em 0.3em; border-radius: 0.2em; font-size: 0.9em; }

      /* Mini map: clickable preview of the latest fix; full controls live on /map. */
      .mini-map-link { display: block; margin: 1rem 0; text-decoration: none; }
      .mini-map {
        height: 240px; width: 100%;
        border: 1px solid color-mix(in srgb, currentColor 20%, transparent);
        border-radius: 0.5rem; overflow: hidden;
        cursor: pointer; position: relative;
      }
      .mini-map-hint {
        position: absolute; right: 0.5rem; top: 0.5rem; z-index: 500;
        background: rgba(255,255,255,0.85); color: #222;
        padding: 0.1em 0.5em; border-radius: 0.25em; font-size: 0.75rem;
        pointer-events: none;
      }
      /* Force Leaflet attribution to a readable contrast in dark mode. */
      .leaflet-control-attribution { background: rgba(255, 255, 255, 0.7) !important; color: #222 !important; }
      .leaflet-control-attribution a { color: #06c !important; }
    </style>
  </head>
  <body>
    <h1>T1000-E Tracker</h1>
    <p class="sub">SenseCAP T1000-E over The Things Network &mdash; EU868</p>

    {latestAny === null ? (
      <div class="card">
        <p>No uplinks recorded yet.</p>
        <p class="sub">Configure the TTN webhook to POST to <code>/api/ingest</code> and wait for the next frame.</p>
      </div>
    ) : (
      <>
        {latestWithFix !== null && (
          <a class="mini-map-link" href="/map" aria-label="Open full map">
            <div
              class="mini-map"
              id="mini-map"
              data-lat={latestWithFix.lat}
              data-lon={latestWithFix.lon}
            >
              <span class="mini-map-hint">View full map &rarr;</span>
            </div>
          </a>
        )}

        <div class="card">
          {latestWithFix !== null ? (
            <>
              <div class="row">
                <span class="label">Position</span>
                <span class="value">{formatLatLon(latestWithFix.lat!, latestWithFix.lon!)}</span>
              </div>
              <div class="row">
                <span class="label">Fix age</span>
                <span class="value">
                  {formatAgo(latestWithFix.ts)}
                  {latestWithFix.f_cnt === latestAny.f_cnt ? null : ' (older than last uplink)'}
                </span>
              </div>
            </>
          ) : (
            <div class="row">
              <span class="label">Position</span>
              <span class="value">No GPS fix yet</span>
            </div>
          )}
          <div class="row">
            <span class="label">Last seen</span>
            <span class="value">{formatAgo(latestAny.ts)}</span>
          </div>

          <div class="group">
            <div class="group-title">GPS</div>
            <div class="row">
              <span class="label">Fix quality</span>
              <span class="value">{fixLabel(latestAny.fix)}</span>
            </div>
            {(latestAny.sats_tracked !== null || latestAny.sats_in_view !== null) && (
              <div class="row">
                <span class="label">Satellites</span>
                <span class="value">
                  {latestAny.sats_tracked ?? '—'} tracked &middot; {latestAny.sats_in_view ?? '—'} in view
                </span>
              </div>
            )}
            {latestAny.hdop !== null && (
              <div class="row">
                <span class="label">HDOP</span>
                <span class="value">{latestAny.hdop.toFixed(2)}</span>
              </div>
            )}
            {latestAny.alt !== null && (
              <div class="row">
                <span class="label">Altitude</span>
                <span class="value">{latestAny.alt} m</span>
              </div>
            )}
            {latestAny.speed !== null && (
              <div class="row">
                <span class="label">Speed</span>
                <span class="value">{latestAny.speed} km/h</span>
              </div>
            )}
          </div>

          <div class="group">
            <div class="group-title">Sensors</div>
            {latestAny.battery_pct !== null && (
              <div class="row">
                <span class="label">Battery</span>
                <span class="value">
                  {latestAny.battery_pct}% &middot; {latestAny.battery_mv} mV
                </span>
              </div>
            )}
            {latestAny.temp_c !== null && (
              <div class="row">
                <span class="label">Temp (PCB)</span>
                <span class="value">{latestAny.temp_c.toFixed(1)} &deg;C</span>
              </div>
            )}
            {latestAny.lux_pct !== null && (
              <div class="row">
                <span class="label">Light</span>
                <span class="value">{latestAny.lux_pct}%</span>
              </div>
            )}
            <div class="row">
              <span class="label">Motion</span>
              <span class="value">
                <span class={latestAny.motion ? 'pill motion' : 'pill'}>
                  {latestAny.motion ? 'detected' : 'still'}
                </span>
              </span>
            </div>
          </div>

          <div class="group">
            <div class="group-title">Radio</div>
            {latestAny.rssi !== null && (
              <div class="row">
                <span class="label">RSSI</span>
                <span class="value">{latestAny.rssi} dBm</span>
              </div>
            )}
            {latestAny.snr !== null && (
              <div class="row">
                <span class="label">SNR</span>
                <span class="value">{latestAny.snr.toFixed(2)} dB</span>
              </div>
            )}
            {latestAny.sf !== null && (
              <div class="row">
                <span class="label">Spreading factor</span>
                <span class="value">SF{latestAny.sf}</span>
              </div>
            )}
            {latestAny.gateway_id !== null && (
              <div class="row">
                <span class="label">Gateway</span>
                <span class="value" title={latestAny.gateway_id}>{shortGateway(latestAny.gateway_id)}</span>
              </div>
            )}
            <div class="row">
              <span class="label">f_cnt</span>
              <span class="value">{latestAny.f_cnt}</span>
            </div>
          </div>
        </div>

        <p>
          <a class="button" href="/map">View on map &rarr;</a>
          <a class="button" href="/timeline" style="margin-left: 0.5em">Timeline &rarr;</a>
          <a class="button" href="/beams" style="margin-left: 0.5em">Beams &rarr;</a>
        </p>
      </>
    )}

    <p class="sub" style="margin-top: 3rem">
      <a href="/gateways">gateways</a> &middot;
      <a href="/settings">settings</a> &middot;
      <a href="/api/auth/logout">sign out</a>
    </p>

    {latestWithFix !== null && (
      <>
        <script
          src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
          integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
          crossorigin="anonymous"
          is:inline
        ></script>
        <script is:inline>
          // @ts-nocheck
          (() => {
            const el = document.getElementById('mini-map');
            if (!el || !window.L) return;
            const lat = parseFloat(el.getAttribute('data-lat'));
            const lon = parseFloat(el.getAttribute('data-lon'));
            if (!Number.isFinite(lat) || !Number.isFinite(lon)) return;

            // Static-ish: no controls, no scroll/drag — the whole tile is wrapped
            // in <a href="/map">, so any click navigates to the full map.
            const map = L.map(el, {
              center: [lat, lon],
              zoom: 16,
              zoomControl: false,
              dragging: false,
              scrollWheelZoom: false,
              doubleClickZoom: false,
              touchZoom: false,
              boxZoom: false,
              keyboard: false,
              tap: false,
              attributionControl: true,
            });
            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
              maxZoom: 19,
              attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
            }).addTo(map);
            L.marker([lat, lon]).addTo(map);
          })();
        </script>
      </>
    )}
  </body>
</html>
