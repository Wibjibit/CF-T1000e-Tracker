---
// Shared page chrome: <html>, <head>, sidebar nav, page <main> container.
// Every authenticated page wraps its content in <Layout> via the default
// slot. The leaflet CSS (only some pages need it) goes through the named
// "head" slot so it lands in the document head.
//
// Sidebar state:
//   - Desktop (>720px): full-width 200px nav, collapsible to a 56px icon
//     rail via the chevron button. Choice persists in localStorage.
//   - Mobile (<=720px): sidebar is hidden behind a hamburger drawer. The
//     drawer open/closed state is CSS-only via a checkbox + :checked.
//
// Active link highlighting uses Astro.url.pathname unless the page passes
// an explicit `activePath` prop.

interface Props {
  title?: string;
  activePath?: string;
}

const { title = 'T1000-E Tracker', activePath } = Astro.props;
const current = activePath ?? Astro.url.pathname;
const isActive = (href: string): boolean => current === href;

// Inline SVG icons (16x16, currentColor-stroke). Pasted into spans via
// set:html. Emoji are inconsistent across platforms; vectorising keeps
// the icon-rail readable on every device.
const IconHome     = `<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7l6-5 6 5v7a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1z"/><path d="M6 15v-5h4v5"/></svg>`;
const IconMap      = `<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 5l4-2 4 2 4-2v9l-4 2-4-2-4 2z"/><path d="M6 3v11"/><path d="M10 5v11"/></svg>`;
const IconTimeline = `<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="2,13 5,9 8,11 11,5 14,8"/></svg>`;
const IconBeams    = `<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="1.4" fill="currentColor"/><path d="M5 5a4 4 0 0 0 0 6"/><path d="M11 5a4 4 0 0 1 0 6"/><path d="M3 3a7 7 0 0 0 0 10"/><path d="M13 3a7 7 0 0 1 0 10"/></svg>`;
const IconGateways = `<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6v9"/><path d="M5 15l3-9 3 9"/><path d="M5.5 12h5"/><path d="M5.5 4a3 3 0 0 1 5 0"/><path d="M3.5 2.5a5 5 0 0 1 9 0"/></svg>`;
const IconSettings = `<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="2.2"/><path d="M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.3 3.3l1.4 1.4M11.3 11.3l1.4 1.4M3.3 12.7l1.4-1.4M11.3 4.7l1.4-1.4"/></svg>`;
const IconSources  = `<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2l5.5 3L8 8 2.5 5z"/><path d="M2.5 8L8 11l5.5-3"/><path d="M2.5 11L8 14l5.5-3"/></svg>`;
const IconSignOut  = `<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4V2.5a1 1 0 0 0-1-1H2.5a1 1 0 0 0-1 1v11a1 1 0 0 0 1 1H8a1 1 0 0 0 1-1V12"/><path d="M14.5 8H6"/><path d="M11.5 5L14.5 8L11.5 11"/></svg>`;
const IconChevron  = `<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="10,3 5,8 10,13"/></svg>`;
const IconHamburger = `<svg viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><line x1="2" y1="4" x2="14" y2="4"/><line x1="2" y1="8" x2="14" y2="8"/><line x1="2" y1="12" x2="14" y2="12"/></svg>`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    {/* Set the collapsed class before paint so we don't flash the wrong
        layout on every navigation. Wrapped in try/catch in case
        localStorage is unavailable (e.g. private browsing). */}
    <script is:inline>
      try {
        if (localStorage.getItem('tracker.sidebar.collapsed') === '1') {
          document.documentElement.classList.add('sidebar-collapsed');
        }
      } catch (e) {}
    </script>

    <slot name="head" />

    <style is:global>
      :root {
        color-scheme: light dark;
        --accent: #1d68d0;
      }
      @media (prefers-color-scheme: dark) {
        :root { --accent: #4ea3ff; }
      }
      * { box-sizing: border-box; }
      html, body {
        margin: 0; padding: 0; height: 100%;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        line-height: 1.5;
      }
      body { display: block; }

      /* Hidden checkbox that drives the mobile drawer open/closed state. */
      #menu-toggle { position: absolute; opacity: 0; pointer-events: none; }

      /* ── App shell ─────────────────────────────────────────────── */
      .app-shell { display: flex; min-height: 100vh; }
      .sidebar {
        flex: 0 0 200px;
        background: color-mix(in srgb, currentColor 4%, transparent);
        border-right: 1px solid color-mix(in srgb, currentColor 14%, transparent);
        padding: 0.9rem 0.7rem;
        display: flex; flex-direction: column; gap: 0.6rem;
        font-size: 0.88rem;
        transition: flex-basis 0.18s ease, padding 0.18s ease;
        z-index: 50;
      }
      .content {
        flex: 1 1 auto; min-width: 0; min-height: 0;
        display: flex; flex-direction: column;
      }

      /* Sidebar header (brand + collapse toggle). */
      .sidebar .head {
        display: flex; align-items: center; gap: 0.4rem;
        padding: 0 0.2rem 0.55rem;
        border-bottom: 1px solid color-mix(in srgb, currentColor 10%, transparent);
      }
      .sidebar .head .brand {
        font-weight: 600; flex: 1 1 auto; min-width: 0;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      }
      .sidebar .head .collapse-btn {
        width: 24px; height: 24px; border-radius: 0.3rem;
        border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
        background: transparent; color: inherit;
        display: inline-flex; align-items: center; justify-content: center;
        cursor: pointer; opacity: 0.7; flex: 0 0 auto;
      }
      .sidebar .head .collapse-btn:hover {
        opacity: 1; background: color-mix(in srgb, currentColor 8%, transparent);
      }
      .sidebar .head .collapse-btn svg { transition: transform 0.18s ease; }

      /* Section grouping in the sidebar. */
      .sidebar nav { display: flex; flex-direction: column; gap: 0.55rem; }
      .sidebar .section { display: flex; flex-direction: column; gap: 0.05rem; }
      .sidebar .section .label {
        font-size: 0.66rem; font-weight: 600; letter-spacing: 0.1em;
        text-transform: uppercase; opacity: 0.55;
        padding: 0.2rem 0.55rem 0.1rem;
      }
      .sidebar a {
        display: flex; align-items: center; gap: 0.6rem;
        padding: 0.32rem 0.55rem; border-radius: 0.3rem;
        color: inherit; text-decoration: none; opacity: 0.85;
      }
      .sidebar a:hover:not(.active) {
        background: color-mix(in srgb, currentColor 8%, transparent); opacity: 1;
      }
      .sidebar a.active {
        background: color-mix(in srgb, var(--accent) 18%, transparent);
        color: var(--accent); font-weight: 600; opacity: 1;
      }
      .sidebar .icon {
        flex: 0 0 16px; width: 16px; height: 16px;
        display: inline-flex; align-items: center; justify-content: center;
      }
      .sidebar .icon svg { width: 16px; height: 16px; display: block; }
      .sidebar .footer {
        margin-top: auto; padding-top: 0.5rem;
        border-top: 1px solid color-mix(in srgb, currentColor 10%, transparent);
        display: flex; flex-direction: column; gap: 0.05rem;
      }

      /* Collapsed (icon-rail) state — desktop/tablet only. */
      html.sidebar-collapsed .sidebar {
        flex-basis: 56px; padding: 0.9rem 0.35rem;
      }
      html.sidebar-collapsed .sidebar .head {
        justify-content: center; padding-left: 0; padding-right: 0;
      }
      html.sidebar-collapsed .sidebar .head .brand { display: none; }
      html.sidebar-collapsed .sidebar .section .label,
      html.sidebar-collapsed .sidebar .link-label { display: none; }
      html.sidebar-collapsed .sidebar a {
        justify-content: center; padding: 0.42rem 0; gap: 0;
      }
      html.sidebar-collapsed .sidebar .head .collapse-btn svg {
        transform: rotate(180deg);
      }

      /* Mobile bar (hamburger). Hidden until ≤720px. */
      .mobile-bar { display: none; }
      .backdrop { display: none; }

      @media (max-width: 720px) {
        .mobile-bar {
          display: flex; align-items: center; gap: 0.7rem;
          padding: 0.55rem 0.9rem;
          border-bottom: 1px solid color-mix(in srgb, currentColor 14%, transparent);
          position: sticky; top: 0; z-index: 60;
          background: Canvas;
        }
        .mobile-bar .hamburger {
          width: 34px; height: 30px; border-radius: 0.3rem;
          border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
          background: transparent; color: inherit;
          display: inline-flex; align-items: center; justify-content: center;
          cursor: pointer; opacity: 0.85;
        }
        .mobile-bar .hamburger:hover {
          opacity: 1; background: color-mix(in srgb, currentColor 8%, transparent);
        }
        .mobile-bar .brand { font-weight: 600; flex: 1 1 auto; }

        /* Keep the shell as a flex column on mobile too — the sidebar is
           position:fixed (out of flow) so this doesn't reintroduce it on
           screen, but it preserves the height chain that lets full-bleed
           map pages (#map { flex: 1 1 auto }) actually fill the viewport.
           Without this, `display: block` left .content height-less and
           the map collapsed to 0px on narrow widths. */
        .app-shell { display: flex; flex-direction: column; }
        .sidebar {
          position: fixed; top: 0; left: 0; height: 100%;
          flex-basis: 240px; width: 240px;
          transform: translateX(-100%);
          transition: transform 0.2s ease;
          box-shadow: 4px 0 18px rgba(0,0,0,0.25);
        }
        /* On mobile the drawer is always full-width — ignore the
           collapsed flag so the rail state doesn't bleed in. */
        html.sidebar-collapsed .sidebar {
          flex-basis: 240px; padding: 0.9rem 0.7rem;
        }
        html.sidebar-collapsed .sidebar .head .brand,
        html.sidebar-collapsed .sidebar .section .label,
        html.sidebar-collapsed .sidebar .link-label { display: initial; }
        html.sidebar-collapsed .sidebar a {
          justify-content: flex-start; padding: 0.32rem 0.55rem; gap: 0.6rem;
        }
        html.sidebar-collapsed .sidebar .head .collapse-btn svg { transform: none; }
        /* The chevron is a desktop affordance; hide it in the mobile drawer. */
        .sidebar .head .collapse-btn { display: none; }

        #menu-toggle:checked ~ .app-shell .sidebar { transform: translateX(0); }
        #menu-toggle:checked ~ .backdrop {
          display: block; position: fixed; inset: 0; z-index: 40;
          background: rgba(0,0,0,0.45);
        }
      }

      /* ── Page-bar (used by /map, /timeline, /beams) ────────────── */
      .page-bar {
        display: flex; align-items: center; gap: 1rem;
        padding: 0.6rem 1rem;
        border-bottom: 1px solid color-mix(in srgb, currentColor 14%, transparent);
        flex-wrap: wrap; flex: 0 0 auto;
      }
      .page-bar h1 { margin: 0; font-size: 1.05rem; font-weight: 600; }
      .page-bar .status { font-size: 0.85rem; opacity: 0.7; }
      .page-bar .auto-refresh {
        display: inline-flex; align-items: center; gap: 0.35em;
        font-size: 0.85rem; opacity: 0.85; cursor: pointer;
      }
      .page-bar .auto-refresh input { cursor: pointer; }
      .page-bar .ranges { margin-left: auto; }
      .page-bar .ranges select {
        font: inherit; padding: 0.35em 0.6em; padding-right: 1.8em; border-radius: 0.3em;
        border: 1px solid color-mix(in srgb, currentColor 22%, transparent);
        background: transparent; color: inherit; cursor: pointer;
        appearance: none; -webkit-appearance: none;
        background-image: linear-gradient(45deg, transparent 50%, currentColor 50%),
                          linear-gradient(135deg, currentColor 50%, transparent 50%);
        background-position: calc(100% - 14px) 50%, calc(100% - 8px) 50%;
        background-size: 6px 6px, 6px 6px;
        background-repeat: no-repeat;
      }
      .page-bar .ranges select:focus {
        outline: 2px solid color-mix(in srgb, currentColor 35%, transparent);
        outline-offset: 1px;
      }
      .page-bar .ranges select option { color: black; background: white; }
      .page-bar .color-toggle { display: inline-flex; align-items: center; font-size: 0.85rem; }
      .page-bar .color-toggle label {
        padding: 0.3em 0.7em; cursor: pointer;
        border: 1px solid color-mix(in srgb, currentColor 22%, transparent);
      }
      .page-bar .color-toggle label:first-of-type { border-radius: 0.3em 0 0 0.3em; border-right: 0; }
      .page-bar .color-toggle label:last-of-type  { border-radius: 0 0.3em 0.3em 0; }
      .page-bar .color-toggle input { display: none; }
      .page-bar .color-toggle input:checked + label {
        background: color-mix(in srgb, currentColor 18%, transparent);
        font-weight: 600;
      }

      /* Keep Leaflet attribution readable in dark mode. Pages that
         don't use Leaflet pay nothing for these rules. */
      .leaflet-control-attribution { background: rgba(255, 255, 255, 0.7) !important; color: #222 !important; }
      .leaflet-control-attribution a { color: #06c !important; }
    </style>
  </head>
  <body>
    <input type="checkbox" id="menu-toggle" />
    <label for="menu-toggle" class="backdrop" aria-hidden="true"></label>

    <header class="mobile-bar">
      <label for="menu-toggle" class="hamburger" aria-label="Open menu" set:html={IconHamburger}></label>
      <span class="brand">T1000-E Tracker</span>
    </header>

    <div class="app-shell">
      <aside class="sidebar">
        <div class="head">
          <span class="brand">T1000-E</span>
          <button class="collapse-btn" id="sidebar-collapse" type="button" title="Toggle sidebar" aria-label="Toggle sidebar" set:html={IconChevron}></button>
        </div>

        <nav>
          <div class="section">
            <span class="label">Live</span>
            <a href="/" class={isActive('/') ? 'active' : ''} title="Home">
              <span class="icon" set:html={IconHome}></span>
              <span class="link-label">Home</span>
            </a>
            <a href="/map" class={isActive('/map') ? 'active' : ''} title="Map">
              <span class="icon" set:html={IconMap}></span>
              <span class="link-label">Map</span>
            </a>
          </div>
          <div class="section">
            <span class="label">History</span>
            <a href="/timeline" class={isActive('/timeline') ? 'active' : ''} title="Timeline">
              <span class="icon" set:html={IconTimeline}></span>
              <span class="link-label">Timeline</span>
            </a>
          </div>
          <div class="section">
            <span class="label">Coverage</span>
            <a href="/beams" class={isActive('/beams') ? 'active' : ''} title="Beams">
              <span class="icon" set:html={IconBeams}></span>
              <span class="link-label">Beams</span>
            </a>
            <a href="/gateways" class={isActive('/gateways') ? 'active' : ''} title="Gateways">
              <span class="icon" set:html={IconGateways}></span>
              <span class="link-label">Gateways</span>
            </a>
          </div>
          <div class="section">
            <span class="label">Manage</span>
            <a href="/sources" class={isActive('/sources') ? 'active' : ''} title="Sources">
              <span class="icon" set:html={IconSources}></span>
              <span class="link-label">Sources</span>
            </a>
          </div>
        </nav>

        <div class="footer">
          <a href="/settings" class={isActive('/settings') ? 'active' : ''} title="Settings">
            <span class="icon" set:html={IconSettings}></span>
            <span class="link-label">Settings</span>
          </a>
          <a href="/api/auth/logout" title="Sign out">
            <span class="icon" set:html={IconSignOut}></span>
            <span class="link-label">Sign out</span>
          </a>
        </div>
      </aside>

      <main class="content">
        <slot />
      </main>
    </div>

    <script is:inline>
      (function () {
        var btn = document.getElementById('sidebar-collapse');
        var menuToggle = document.getElementById('menu-toggle');
        if (btn) {
          btn.addEventListener('click', function () {
            var collapsed = document.documentElement.classList.toggle('sidebar-collapsed');
            try {
              localStorage.setItem('tracker.sidebar.collapsed', collapsed ? '1' : '0');
            } catch (e) {}
          });
        }
        // Tapping a sidebar link closes the mobile drawer (otherwise it'd
        // remain over the new page until the user dismisses it).
        document.querySelectorAll('.sidebar a').forEach(function (a) {
          a.addEventListener('click', function () {
            if (menuToggle) menuToggle.checked = false;
          });
        });
      })();
    </script>
  </body>
</html>
