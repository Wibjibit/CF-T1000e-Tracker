{
  "$schema": "node_modules/wrangler/config-schema.json",

  // ────────────────────────────────────────────────────────────────────
  // FORK SETUP — edit these three values before your first `wrangler deploy`:
  //
  //   1. account_id     - find via `wrangler whoami` after `wrangler login`,
  //                       OR in the Cloudflare dashboard URL after /accounts/
  //   2. database_id    - returned by `wrangler d1 create tracker`. Paste the
  //                       UUID it prints here, then run
  //                       `wrangler d1 migrations apply tracker --remote`.
  //   3. routes[0].pattern - your custom domain on a zone owned by the same
  //                       account, OR delete the whole `routes` block to
  //                       deploy on the auto-assigned *.workers.dev URL.
  // ────────────────────────────────────────────────────────────────────

  "name": "cf-t1000e-tracker",
  "account_id": "a3c6a5b41c0312ead688ef0c16313b45",
  "compatibility_date": "2026-05-16",
  "compatibility_flags": ["nodejs_compat"],

  // Note: 'main' is intentionally omitted. The @astrojs/cloudflare adapter
  // generates dist/_worker.js/index.js during 'astro build' and writes its
  // own wrangler config (dist/server/wrangler.json) alongside it. Wrangler
  // picks that up at deploy time via `--config dist/server/wrangler.json`.
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },

  "observability": {
    "enabled": true
  },

  // ────────────────────────────────────────────────────────────────────
  // CRON TRIGGERS.
  //
  // The Find Hub read poller's cron + Durable Object now live in a SEPARATE
  // companion worker (wrangler.findhub.jsonc) — see the FIND HUB POLLER note
  // below for why. The only cron that would belong on THIS (site) worker is the
  // Phase 4 static-EID refresh kick ("0 4 * * *"); it stays commented until that
  // handler lands. Note: the live deploy uses dist/server/wrangler.json
  // generated by the @astrojs/cloudflare adapter at build time, so mirror any
  // active crons there (the adapter copies `triggers` through from this file).
  //
  // "triggers": {
  //   "crons": ["0 4 * * *"]
  // },

  // ────────────────────────────────────────────────────────────────────
  // FIND HUB POLLER — Durable Object (Phase 3.2), now WIRED via a companion
  // worker (Phase 3.3). The DO class is src/do/findhub-poller.ts; its pure logic
  // is src/lib/fmdn/findhub.ts (vitest-covered). It opens an ephemeral MCS push
  // socket per alarm tick.
  //
  // It is deliberately NOT bound on this (site) worker. The @astrojs/cloudflare
  // adapter (v13.5.1) deploys `no_bundle: true` (main = dist/server/entry.mjs):
  // wrangler ships the pre-built Astro app as-is and bundles nothing else, so it
  // cannot pull in the DO class plus its @noble / `cloudflare:sockets` deps.
  // Binding it here would make `wrangler deploy` fail with "no Durable Object
  // class named FindHubPoller". Per master-plan Phase 3.2 option (b), the DO +
  // its */10 cron therefore live in the companion worker wrangler.findhub.jsonc
  // (normal bundling, same D1 database). Deploy it with:
  //   wrangler deploy --config wrangler.findhub.jsonc
  // The site worker needs no DO binding — nothing here calls the DO directly;
  // it self-schedules via its alarm and the companion cron kicks it.

  // App-layer credential-encryption key for the `accounts` table. Set as a
  // Workers Secret (NOT here): `wrangler secret put BLOB_ENC_KEY` with 32
  // random bytes, base64-encoded. Locally it comes from .dev.vars. See
  // src/lib/crypto/blob.ts and .dev.vars.example.

  // Custom domain binding. The zone (e.g. wibjibit.com) must already be on
  // the same Cloudflare account as this Worker. Cloudflare auto-provisions
  // the TLS certificate within a minute or two of the first deploy.
  //
  // Delete this `routes` block if you don't have a custom domain yet — the
  // Worker will be reachable on cf-t1000e-tracker.<account>.workers.dev.
  "routes": [
    { "pattern": "tracker.wibjibit.com", "custom_domain": true }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tracker",
      "database_id": "1b4cbacf-0841-48fa-a672-84ff04df5a33",
      "migrations_dir": "migrations"
    }
  ]
}
