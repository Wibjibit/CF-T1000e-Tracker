{
  "name": "cf-t1000e-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare-hosted map + timeline for a SenseCAP T1000-E LoRaWAN tracker.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev --config dist/server/wrangler.json",
    "deploy": "astro build && wrangler deploy --config dist/server/wrangler.json",
    "check": "astro check && tsc --noEmit",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.5.1",
    "astro": "^6.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.6.0",
    "wrangler": "^4.75.0"
  }
}
